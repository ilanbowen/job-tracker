APP_NAME=Job Tracker
APP_ENV=local

# PostgreSQL is the default database for this project.
# For direct development from WSL2, expose the Kubernetes PostgreSQL Service first:
# kubectl port-forward -n job-tracker svc/job-tracker-postgres 5432:5432
DATABASE_URL=postgresql+psycopg2://jobtracker:change-me-local-only@localhost:5432/jobtracker
LOGO_DIR=data/logos
SEED_LOGO_DIR=logos
